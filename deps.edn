;; org-thorchain — THORChain swap memo grammar + quote/inbound requests as data.
;; Pure .cljc, dual-platform, ZERO runtime dependencies and NO network access:
;; every request is returned as {:method :path :query}, so the caller supplies
;; the transport and this stays testable without a node.
{:paths ["src"]
 :deps {}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
